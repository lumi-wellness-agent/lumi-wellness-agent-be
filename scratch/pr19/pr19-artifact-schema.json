{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR-19 daily journal artifact",
  "type": "object",
  "required": ["protocol_id", "challenge_start_at", "entry_date", "good_things", "daily_completion", "challenge_status"],
  "properties": {
    "protocol_id": {"const": "PR-19"},
    "challenge_start_at": {"type": "string", "format": "date-time"},
    "entry_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "good_things": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "required": ["content"], "properties": {"content": {"type": "string", "minLength": 1}}}},
    "timer": {"type": "object", "properties": {"started_at": {"type": "string", "format": "date-time"}, "elapsed_seconds": {"type": "integer", "minimum": 0}}},
    "daily_completion": {"type": "boolean"},
    "challenge_status": {"enum": ["ACTIVE", "COMPLETED", "STOPPED"]},
    "last_edited_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
