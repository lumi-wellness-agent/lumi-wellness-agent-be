# Supabase Postgres 연결 문자열 — 대시보드의 Connect 창에서 복사한다 (README '데이터베이스' 참고).
# 로컬 개발은 Session pooler(포트 5432)를 쓴다. Direct connection은 기본이 IPv6라
# IPv4 add-on 없이는 IPv4 네트워크에서 접속되지 않는다.
# 비워 두면 DB 없이 뜨고 /health/db는 503을 돌려준다.
DATABASE_URL=

# OpenAI API 키(1순위) — intake(구조화 출력)·plan(Tool 루프)이 쓴다(app/agent/assembly.py).
# 근거 추출·임베딩(text-embedding-3-small)도 같은 키를 쓴다. 비워 두면 OpenAI를 등록하지 않고,
# 둘 다 비면 세션 그래프를 조립하지 않는다. 테스트는 대본 모델로 돈다.
OPENAI_API_KEY=
# Anthropic API 키(폴백) — OpenAI가 5xx로 재시도 1회까지 실패하거나 4xx면 Claude Haiku로 넘어간다.
# 비워 두면 폴백 없이 OpenAI만 쓴다.
ANTHROPIC_API_KEY=

# 모델은 하나로 통일한다. 기본값이 있으니 바꿀 때만 적는다 — 빈 값으로 두면 기본값을 덮어쓴다.
# LLM_MODEL=gpt-5.4-mini
# FALLBACK_MODEL=claude-haiku-5-5
# 임베딩 모델은 바꾸면 근거를 다시 임베딩해야 검색에 나온다(차원 1536 고정).
# EMBEDDING_MODEL=text-embedding-3-small

# A 콘텐츠 공급자 — 비어 있으면 해당 공급자를 호출하지 않는다.
# 실제 키는 커밋하지 않는 .env에만 넣는다.
PIXABAY_API_KEY=
FREESOUND_API_KEY=
AI_HORDE_API_KEY=

# 요청 제한 시간은 필요할 때만 바꾼다.
# CONTENT_REQUEST_TIMEOUT_SECONDS=10
# AI_HORDE_POLL_TIMEOUT_SECONDS=60

# 세션 API를 부를 FE 오리진(쉼표로 구분). 기본값은 로컬 개발 서버(3000)와 운영 FE이고, FE 프리뷰
# 배포는 정규식으로 허용한다(app/config.py). 바꿀 때만 적는다 — 빈 값으로 두면 기본값을 덮어쓴다.
# CORS_ORIGINS=http://localhost:3000,https://lumi-wellness-agent-fe.vercel.app
# CORS_ORIGIN_REGEX=https://lumi-wellness-agent-fe-[a-z0-9-]+-koothemavericks-projects\.vercel\.app

# Supabase 프로젝트 주소(https://<ref>.supabase.co) — 대시보드 Project Settings → Data API의 Project URL.
# 세션 API가 FE의 로그인 토큰(Google · Kakao)을 이 프로젝트의 공개 키(JWKS)로 검증한다(app/auth.py).
# 비우면 세션 API가 503을 돌려준다 — 인증 없이 열리지 않는다. 비밀 값이 아니다.
SUPABASE_URL=

# 정리 작업(GET /internal/cleanup) 키 — Vercel Cron이 Authorization: Bearer로 보낸다(vercel.json crons).
# 로컬에서는 비워 둔다. 운영에는 긴 임의 문자열을 Vercel 환경 변수에 넣는다.
CRON_SECRET=

# 원문 보관 기한(일)과 미완료 세션을 만료로 볼 쉼 시간(시간). 바꿀 때만 적는다(app/records.py).
# TEXT_RETENTION_DAYS=90
# SESSION_IDLE_HOURS=24
# 게스트(익명 로그인 체험)를 쓰지 않은 채 두면 사용자째 지우기까지의 일수. 바꿀 때만 적는다.
# GUEST_RETENTION_DAYS=1

# Art Institute of Chicago API는 키가 필요 없다. OpenAlex·Europe PMC도 키 없이 호출할 수 있다.
